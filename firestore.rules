rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validStudyHallDocument(siteId) {
      return request.resource.data.keys().hasOnly(['database', 'siteId', 'updatedAt'])
        && request.resource.data.siteId == siteId
        && request.resource.data.database is map;
    }

    match /studyHalls/{siteId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn() && validStudyHallDocument(siteId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
